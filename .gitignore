# ─── Secrets & local config ────────────────────────────────────────
.env
.env.local
frontend/.env.local
frontend/.env.*.local

# ─── Node.js ───────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.npm-cache/
dist/
frontend/dist/
*.tsbuildinfo

# ─── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# ─── Octopus large binary / output files ───────────────────────────
# Restart / wavefunction binary objects
*.obf
# NetCDF volumetric data
*.nc
# VTK / Cube files
*.vtk
*.cube
# Time-dependent run folders
td.general/
restart/
# Rendered PNGs (regeneratable)
@Octopus_docs/output/renders/

# Keep the organized output subdirectory structure but ignore big data
@Octopus_docs/output/gs/
@Octopus_docs/output/td/
@Octopus_docs/output/runs/
# Allow .gitkeep files so directory structure is versioned
!@Octopus_docs/output/gs/.gitkeep
!@Octopus_docs/output/td/.gitkeep
!@Octopus_docs/output/renders/.gitkeep

# Test scripts (local dev only, not needed on cloud)
test_*.js
test_*.py
test_*.sh
# Cloud deployment helper scripts (local SSH scripts)
deploy_cloud.py
check_and_start_cloud.py
cloud_status.py
start_vite_cloud.py

# Docker temp test run directories
docker/workspace/test_oct*/
docker/workspace/test_*.py
docker/workspace/test_out.txt
docker/workspace/__pycache__/
docker/workspace/*.log
docker/workspace/*.bak
# Docker temp fix/debug scripts
docker/workspace/fix_*.py
docker/workspace/apply_fixes.py
docker/workspace/pbs_debug.py
docker/workspace/poll_debug.py
docker/workspace/start_server.sh

# ─── Development state / logs (machine-local, not useful in git) ───
*.bak
tmp_*
computation_log.md
dev_state.json
latest_api_output.json
debug_output_dirac.json
debug_*.py
logs/
harness_logs/
run/
# One-off migration/util scripts
*_wasm.js
physics_mcp_server.py
# ─── Windows path artifacts (created by git on Linux) ──────────────
e:/

# ─── Benchmark run artifacts ────────────────────────────────────────
benchmarks/*.log
benchmarks/*.err
benchmarks/*.out
benchmarks/*.stdout
benchmarks/*.stderr
benchmarks/direct_test*/

# ─── AI / editor metadata ──────────────────────────────────────────
.cobridge
.traerules
.cursorrules
.github/copilot-instructions.md

# ─── Claude Code ──────────────────────────────────────────────────
.claudeignore
.claude/
.mcp.json
session-env/
shell-snapshots/
telemetry/

# ─── OpenClaw state (machine-local, managed by harness) ───────────
state/dirac_solver_progress_sync.json
state/dirac_exec_queue.json
state/copilot_openclaw_bridge.json
state/multi_agent_learning_state.json
.pids/

# ─── Unison sync artifacts ────────────────────────────────────────
.unison/

# ─── Scripts artifacts (not core infrastructure) ──────────────────
scripts/*.patch
scripts/visitlog.py
